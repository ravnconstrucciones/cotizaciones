<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ravn.bridge-cotizador</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/ezeotero/.ravn-bridge/run-residente.sh</string>
  </array>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/ezeotero</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/Users/ezeotero/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ezeotero/.ravn-bridge/logs/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ezeotero/.ravn-bridge/logs/bridge.err.log</string>
</dict>
</plist>
