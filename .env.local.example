NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Admin client (server-side, API routes) — createSupabaseAdminClient lo usa
# junto con NEXT_PUBLIC_SUPABASE_URL de arriba.
SUPABASE_SERVICE_ROLE_KEY=

# Mesa conversacional (spec 2026-07-25): secreto compartido para el header
# x-ravn-agente — el middleware deja pasar sin sesión de navegador SOLO la
# allowlist de /api/cotizaciones/* (ver src/middleware.ts). El puente-cotizador
# (daemon local, corre fuera de este repo con su propio env en
# ~/.ravn-puente/env — NO lee este archivo) necesita el MISMO valor acá:
# RAVN_AGENTE_SECRET, RAVN_APP_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# y opcionalmente PUENTE_MODELO / PUENTE_CODEX_TIMEOUT_MS
# (daemon/puente-cotizador/puente.ts, motor-fable.ts, motor-codex.ts).
RAVN_AGENTE_SECRET=

# Lectura automática de comprobantes (foto/audio) en Caja — elegí proveedor con CASHFLOW_EXTRACT_PROVIDER.
# gemini: imágenes + audio (recomendado si usás Google AI). También: GOOGLE_API_KEY, GOOGLE_AI_API_KEY.
GEMINI_API_KEY=
# Opcional: modelo (por defecto gemini-2.5-flash). Si Google avisa que el modelo no está disponible, elegí uno en AI Studio.
# GEMINI_MODEL=gemini-2.5-flash-lite

# claude: solo imágenes (Anthropic). El audio siempre usa Gemini si hay GEMINI_API_KEY.
ANTHROPIC_API_KEY=
# Opcional: modelo (por defecto claude-3-5-sonnet-20241022)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# auto (defecto): si hay GEMINI_API_KEY, usa Gemini para fotos; si no, Claude si hay ANTHROPIC_API_KEY.
# Forzar: CASHFLOW_EXTRACT_PROVIDER=gemini | claude | auto
CASHFLOW_EXTRACT_PROVIDER=auto
