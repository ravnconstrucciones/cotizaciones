# Read-only bridge to the existing App RAVN quotation APIs.
RAVN_APP_URL=https://app.example.com
RAVN_COTIZADOR_READ_SECRET=replace-with-a-dedicated-read-only-secret

# El PASE del expediente: la ÚNICA escritura del laboratorio sobre App RAVN
# (POST /api/cotizaciones/<id>/pase — deja el extracto y el precio). Credencial
# aparte y distinta de la de lectura: si coinciden, App RAVN rechaza el bypass.
# Con este secreto no se puede aprobar, emitir ni tocar plata.
RAVN_COTIZADOR_WRITE_SECRET=replace-with-a-dedicated-write-secret

# Single-user protection for this standalone product. Vercel/HTTPS required.
COTIZADOR_BASIC_USER=eze
COTIZADOR_BASIC_PASSWORD=replace-with-a-long-random-password

# Optional. Used only for visual validation in local development.
COTIZADOR_PREVIEW_ENABLED=0

# El taller (ítems a mano y decisiones) escribe en tablas propias del cotizador
# dentro de la MISMA base de App RAVN. Sin esto, la mesa falla cerrada y lo dice.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key
